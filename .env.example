# X-sevenAI Environment Variables - Phase 2 Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# GENERAL SETTINGS
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ============================================================================
# LLM PROVIDERS (AI Orchestration Service)
# ============================================================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-70b-versatile

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=3600

# ============================================================================
# PINECONE (Vector Database for RAG)
# ============================================================================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=x7ai-knowledge

# ============================================================================
# TEMPORAL (Workflow Orchestration)
# ============================================================================
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default

# ============================================================================
# KAFKA (Event Streaming)
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_RESERVATIONS=reservations
KAFKA_TOPIC_ANALYTICS=analytics
KAFKA_CONSUMER_GROUP=x7ai-consumers

# ============================================================================
# ELEVENLABS (Text-to-Speech)
# ============================================================================
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=default

# ============================================================================
# LIVEKIT (WebRTC)
# ============================================================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ============================================================================
# SERVICE PORTS
# ============================================================================
# Auth Service
AUTH_SERVICE_HOST=0.0.0.0
AUTH_SERVICE_PORT=8010

# AI Orchestration Service
AI_ORCHESTRATION_HOST=0.0.0.0
AI_ORCHESTRATION_PORT=8020

# Business Logic Service
BUSINESS_LOGIC_HOST=0.0.0.0
BUSINESS_LOGIC_PORT=8030

# Chat & Communication Service
CHAT_SERVICE_HOST=0.0.0.0
CHAT_SERVICE_PORT=8040

# Global Chat Service
GLOBAL_CHAT_HOST=0.0.0.0
GLOBAL_CHAT_PORT=8050

# Analytics Dashboard Service
ANALYTICS_HOST=0.0.0.0
ANALYTICS_PORT=8060

# POS Service
POS_SERVICE_HOST=0.0.0.0
POS_SERVICE_PORT=8070

# API Gateway
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
JWT_SECRET=your_jwt_secret_key_replace_in_production_min_32_chars
JWT_EXPIRY=86400
JWT_ALGORITHM=HS256

# ============================================================================
# CORS SETTINGS
# ============================================================================
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ============================================================================
# DOCKER & KUBERNETES
# ============================================================================
DOCKER_REGISTRY=your-docker-registry
K8S_NAMESPACE=x7ai
K8S_CLUSTER_NAME=x7ai-cluster

# ============================================================================
# CLOUD INFRASTRUCTURE
# ============================================================================
TERRAFORM_BACKEND=local
AWS_REGION=us-west-1
GCP_REGION=us-central1

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================
# Zapier
ZAPIER_WEBHOOK_URL=your_zapier_webhook_url

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_RAG=true
ENABLE_VOICE=true
ENABLE_WEBRTC=true
ENABLE_PDF_PROCESSING=true
