# X-sevenAI API Gateway Environment Configuration

# Application Settings
ENVIRONMENT=development
GATEWAY_SERVICE_HOST=0.0.0.0
GATEWAY_SERVICE_PORT=8000
LOG_LEVEL=INFO
ENABLE_DOCS=true

# CORS Settings
CORS_ORIGINS=*

# Service URLs - Internal Microservices
AUTH_SERVICE_URL=http://auth-service:8010
BUSINESS_LOGIC_SERVICE_URL=http://business-logic-service:8020
AI_ORCHESTRATION_SERVICE_URL=http://ai-orchestration-service:8030
CHAT_COMMUNICATION_SERVICE_URL=http://chat-communication-service:8040
ANALYTICS_DASHBOARD_SERVICE_URL=http://analytics-dashboard-service:8050
NOTIFICATION_INTEGRATION_SERVICE_URL=http://notification-integration-service:8060
GLOBAL_CHAT_SERVICE_URL=http://global-chat-service:8070
DEDICATED_BUSINESS_CHAT_SERVICE_URL=http://dedicated-business-chat-service:8050
POS_SERVICE_URL=http://pos-service:8070
TEMPLATE_SELECTION_SERVICE_URL=http://template-selection-service:8090
MONITORING_LOGGING_SERVICE_URL=http://monitoring-logging-service:8080
DEVOPS_SERVICE_URL=http://devops-service:8100

# Authentication Settings
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=3600
ENABLE_OAUTH2=true
ENABLE_API_KEY_AUTH=true

# Supabase Settings (from root .env)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# Rate Limiting
ENABLE_RATE_LIMITING=true
DEFAULT_RATE_LIMIT=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_GUEST=20
RATE_LIMIT_BASIC=100
RATE_LIMIT_PREMIUM=500
RATE_LIMIT_ENTERPRISE=2000

# Circuit Breaker Settings
ENABLE_CIRCUIT_BREAKER=true
CB_FAILURE_THRESHOLD=5
CB_TIMEOUT=60
CB_RECOVERY_TIMEOUT=30

# Health Check Settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Request Timeout Settings
DEFAULT_REQUEST_TIMEOUT=30
AI_REQUEST_TIMEOUT=60
ANALYTICS_REQUEST_TIMEOUT=45

# Retry Settings
ENABLE_RETRIES=true
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0

# Security Settings
ENABLE_SECURITY_HEADERS=true
ENABLE_REQUEST_VALIDATION=true
MAX_REQUEST_SIZE=10485760
ENABLE_IP_WHITELIST=false

# Multi-tenancy
ENABLE_MULTI_TENANCY=true
REQUIRE_TENANT_ID=false

# Monitoring
ENABLE_PROMETHEUS=true
ENABLE_DISTRIBUTED_TRACING=true
ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# WebSocket Settings
ENABLE_WEBSOCKET_PROXY=true
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=60

# API Versioning
ENABLE_API_VERSIONING=true
API_VERSIONS=v1

# Entry Points
ENABLE_QR_ENTRY=true
ENABLE_WHATSAPP_ENTRY=true
ENABLE_SOCIAL_ENTRY=true
ENABLE_VOICE_ENTRY=true
ENABLE_WEB_ENTRY=true
ENABLE_API_ENTRY=true

# Caching
ENABLE_RESPONSE_CACHE=true
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Load Balancing
ENABLE_LOAD_BALANCING=false
LOAD_BALANCE_ALGORITHM=round_robin

# Service Discovery
ENABLE_SERVICE_DISCOVERY=false
SERVICE_DISCOVERY_TYPE=static

# Request Transformation
ENABLE_REQUEST_TRANSFORMATION=true
ENABLE_RESPONSE_TRANSFORMATION=true

# Admin API
ENABLE_ADMIN_API=true
ADMIN_API_KEY=admin-secret-key-change-in-production
