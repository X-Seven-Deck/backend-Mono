# POS Service Configuration

# Service Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
POS_SERVICE_HOST=0.0.0.0
POS_SERVICE_PORT=8070

# Supabase Database
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Authentication
JWT_SECRET=your_jwt_secret_key_replace_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
REDIS_TTL=3600

# Inter-Service Communication
DASHBOARD_SERVICE_URL=http://localhost:8060
API_GATEWAY_URL=http://localhost:8000

# CORS Settings
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Tax Configuration
DEFAULT_TAX_RATE=0.10
TAX_CALCULATION_MODE=location_based

# Receipt Configuration
RECEIPT_PREFIX=RCP
BUSINESS_NAME=Xseven Business
BUSINESS_ADDRESS=123 Main St
BUSINESS_PHONE=+1234567890

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091

# Feature Flags
ENABLE_OFFLINE_MODE=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_RECEIPT_EMAIL=true
