# ==============================================================================
# X-sevenAI Notification Integration Service - Environment Configuration
# ==============================================================================

# Service Configuration
# ==============================================================================
SERVICE_NAME=notification-integration-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8006
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (Supabase PostgreSQL)
# ==============================================================================
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/x7ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Twilio Configuration (SMS & WhatsApp)
# ==============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# SendGrid Configuration (Email)
# ==============================================================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@x7ai.com
SENDGRID_FROM_NAME=X-sevenAI

# Firebase Configuration (Push Notifications)
# ==============================================================================
FIREBASE_CREDENTIALS_PATH=/app/config/firebase-credentials.json

# Zapier Configuration (Webhooks & Integrations)
# ==============================================================================
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_webhook_id
ZAPIER_API_KEY=your_zapier_api_key

# Kafka Configuration (Event-Driven Notifications)
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NOTIFICATION_TOPIC=notifications
KAFKA_CONSUMER_GROUP=notification-service-group
KAFKA_ENABLE=true

# Redis Configuration (Caching & Rate Limiting)
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_TTL=3600

# Celery Configuration (Task Scheduling)
# ==============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiting Configuration
# ==============================================================================
RATE_LIMIT_SMS=100
RATE_LIMIT_EMAIL=1000
RATE_LIMIT_PUSH=5000
RATE_LIMIT_WEBHOOK=500
RATE_LIMIT_GLOBAL=1000/hour

# Retry Configuration
# ==============================================================================
MAX_RETRIES=3
RETRY_DELAY=5
RETRY_BACKOFF_MULTIPLIER=2

# Template Storage
# ==============================================================================
TEMPLATE_STORAGE_PATH=/app/templates

# Monitoring & Observability
# ==============================================================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
ENABLE_METRICS=true
ENABLE_TRACING=true

# Security
# ==============================================================================
WEBHOOK_SIGNATURE_SECRET=your_webhook_signature_secret
API_KEY_HEADER=X-API-Key

# Feature Flags
# ==============================================================================
ENABLE_SMS=true
ENABLE_EMAIL=true
ENABLE_PUSH=true
ENABLE_WHATSAPP=true
ENABLE_WEBHOOK=true
ENABLE_SCHEDULER=true
ENABLE_ANALYTICS=true

# Business Logic
# ==============================================================================
MAX_BATCH_SIZE=500
NOTIFICATION_TTL_DAYS=90

# CORS Configuration
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,https://app.x7ai.com
CORS_ALLOW_CREDENTIALS=true
