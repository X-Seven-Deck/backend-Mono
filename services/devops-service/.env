# DevOps Service Configuration
SERVICE_NAME=devops-service
SERVICE_PORT=8100
ENVIRONMENT=development

# Kubernetes Configuration
KUBECONFIG_PATH=/path/to/kubeconfig
KUBERNETES_NAMESPACE=x7ai-production

# ArgoCD Configuration
ARGOCD_SERVER=argocd.x7ai.com
ARGOCD_TOKEN=your-argocd-token
ARGOCD_NAMESPACE=argocd

# Prometheus Configuration
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091

# Grafana Configuration
GRAFANA_URL=http://grafana:3000
GRAFANA_API_KEY=your-grafana-api-key

# Jaeger Configuration
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831

# PagerDuty Configuration
PAGERDUTY_API_KEY=your-pagerduty-key
PAGERDUTY_INTEGRATION_KEY=your-integration-key

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Chaos Engineering
CHAOS_MESH_NAMESPACE=chaos-testing
CHAOS_EXPERIMENTS_ENABLED=false

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=5

# Multi-Region Configuration
PRIMARY_REGION=us-east-1
SECONDARY_REGIONS=us-west-1,eu-west-1
ENABLE_MULTI_REGION=false

# SLO Configuration
DEFAULT_AVAILABILITY_SLO=99.9
DEFAULT_LATENCY_SLO_MS=500
DEFAULT_ERROR_RATE_SLO=1.0
